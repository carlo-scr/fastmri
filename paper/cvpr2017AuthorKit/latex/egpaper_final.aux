\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces FA-KGD per-step pipeline. A frozen EDM denoiser (grey) produces the prior estimate $\mu $; FA-KGD's three training-free components (blue) then form a frequency-adaptive, progressively-gated Kalman correction before the DDIM step. The per-frequency noise map $\hat  {\sigma }_i^2$ is initialised once from an ACS radial fit (\Cref  {eq:radial_model}) and refined online by the M-step (\Cref  {eq:mstep}). No weights are added to the frozen prior.}}{4}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{4}{FA-KGD per-step pipeline. A frozen EDM denoiser (grey) produces the prior estimate $\mu $; FA-KGD's three training-free components (blue) then form a frequency-adaptive, progressively-gated Kalman correction before the DDIM step. The per-frequency noise map $\hatsig _i^2$ is initialised once from an ACS radial fit (\Cref {eq:radial_model}) and refined online by the M-step (\Cref {eq:mstep}). No weights are added to the frozen prior}{figure.caption.1}{}}
\newlabel{fig:pipeline@cref}{{[figure][1][]1}{[1][3][]4}{}{}{}}
