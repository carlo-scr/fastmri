\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Qualitative comparison on fastMRI brain ($R{=}4$, $T{=}20$, domain-matched EDM). FA-KGD reduces residual energy at cortical and ventricular edges where $\Pi $GDM produces Gibbs-like ringing. Error maps share a colour scale; per-slice PSNR/SSIM overlaid.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:recon}{{1}{6}{Qualitative comparison on fastMRI brain ($R{=}4$, $T{=}20$, domain-matched EDM). FA-KGD reduces residual energy at cortical and ventricular edges where $\Pi $GDM produces Gibbs-like ringing. Error maps share a colour scale; per-slice PSNR/SSIM overlaid}{figure.caption.3}{}}
\newlabel{fig:recon@cref}{{[figure][1][]1}{[1][5][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scaling with step budget $T$ on brain $R{=}4$ (domain-matched EDM; pilot subset). (a)~$\Delta $PSNR (FA-KGD $-$ $\Pi $GDM) grows monotonically with $T$. (b)~$\Pi $GDM peaks at $T{=}50$ then degrades; FA-KGD stays flat, consistent with FPDC eliminating $\Pi $GDM's late-$T$ over-correction. (c)~SSIM follows the same trend. Full $192$-slice numbers in \Cref  {tab:tscaling,tab:tscaling_knee}.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:scaling}{{2}{6}{Scaling with step budget $T$ on brain $R{=}4$ (domain-matched EDM; pilot subset). (a)~$\Delta $PSNR (FA-KGD $-$ $\Pi $GDM) grows monotonically with $T$. (b)~$\Pi $GDM peaks at $T{=}50$ then degrades; FA-KGD stays flat, consistent with FPDC eliminating $\Pi $GDM's late-$T$ over-correction. (c)~SSIM follows the same trend. Full $192$-slice numbers in \Cref {tab:tscaling,tab:tscaling_knee}}{figure.caption.6}{}}
\newlabel{fig:scaling@cref}{{[figure][2][]2}{[1][5][]6}{}{}{}}
